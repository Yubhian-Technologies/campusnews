# ---------------------------------------------------------------------------
# CampusNews environment configuration. Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# --- Firebase Web (client) config -------------------------------------------
# Firebase Console -> Project settings -> Your apps -> Web app -> SDK config.
# These are public by design (they identify the project, not authorize access).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The single society this deployment serves (Firestore societyId).
NEXT_PUBLIC_SOCIETY_ID=sves

# --- Firebase Admin (server) credentials — NEVER exposed to the browser ------
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. Provide the credentials one of two ways:
#
#   (a) File path (simplest for local dev). Save the JSON in the project (it is
#       gitignored via serviceAccount*.json) and point to it:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.local.json
#
#   (b) Base64 of the JSON (preferred for hosted deploys like Vercel):
#         base64 -i serviceAccount.json | tr -d '\n'
# FIREBASE_SERVICE_ACCOUNT_B64=

# Session cookie name (optional; defaults to campusnews_session).
SESSION_COOKIE_NAME=campusnews_session

# --- Local emulator development (optional) ----------------------------------
# Uncomment to point the app at the Firebase Local Emulator Suite. With these
# set, the Admin SDK works without a service-account key.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8080
